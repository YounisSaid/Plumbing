@model List<HomePageListMV>
@{
    ViewData["Title"] = "GetHomePageList";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h5 class="card-title">Home Page Content Information</h5>

<nav>
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="HomePage" asp-action="GetHomePageList">Home Page</a></li>
    </ol>
</nav>

<div class="card">
    <div class="card-body">

        <table class="table table-hover">
            <thead>
                <tr>
                    <th scope="col">Id</th>
                    <th scope="col">Header</th>
                    <th scope="col">Video Link</th>
                    <th scope="col">Created Date</th>
                    <th scope="col">Updated Date</th>
                    <th scope="col">Edit</th>
                    <th scope="col">Delete</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Header</td>

                        @if (!string.IsNullOrEmpty(item.VideoLink))
                        {
                            <td>Assigned</td>
                        }
                        else
                        {
                            <td>Not Assigned</td>
                        }

                        <td>@item.CreatedAt</td>
                        <td>@item.UpdatedAt</td>

                        <td>
                            <a asp-area="Admin" asp-controller="HomePage" asp-action="UpdateHomePage" asp-route-id="@item.Id" data-id="@item.Id" class="btn btn-warning btn-sm"> Edit</a>
                        </td>
                        <td>
                            <a asp-area="Admin" asp-controller="HomePage" asp-action="DeleteHomePage" asp-route-id="@item.Id" data-id="@item.Id" class="btn btn-danger btn-sm"> Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if(!Model.Any())
        {
            <div>
                <a asp-area="Admin" asp-controller="HomePage" asp-action="AddHomePage" class="btn btn-success btn-sm"> Add Home Page Item</a>
            </div>
        }
        

    </div>
</div>