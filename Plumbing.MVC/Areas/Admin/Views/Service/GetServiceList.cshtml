@model List<ServiceListMV>
@{
    ViewData["Title"] = "GetServiceList";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<h5 class="card-title">Service List</h5>

<nav>
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Service" asp-action="GetServiceList">Service</a></li>
    </ol>
</nav>

<div class="card">
    <div class="card-body">

        <!-- Table with hoverable rows -->
        <table class="table table-hover">
            <thead>
                <tr>
                    @* Assuming Id is often displayed or used for reference in admin tables *@
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Created Date</th>
                    <th scope="col">Updated Date</th>
                    <th scope="col">Edit</th>
                    <th scope="col">Delete</th>
                </tr>
            </thead>
            <tbody>

                @foreach (var item in Model)
                {
                    <tr>
                        <th scope="row">@item.Id</th>
                        <td>@item.Name</td>
                        <td>@item.CreatedAt</td>
                        <td>@item.UpdatedAt</td>
                        <td>
                            <a asp-area="Admin" asp-controller="Service" asp-action="UpdateService" asp-route-id="@item.Id" data-id="@item.Id" class="btn btn-warning btn-sm"> Edit</a>
                        </td>
                        <td>
                            <a asp-area="Admin" asp-controller="Service" asp-action="DeleteService" asp-route-id="@item.Id" data-id="@item.Id" class="btn btn-danger btn-sm"> Delete</a>
                        </td>

                    </tr>
                }
            </tbody>
        </table>

        @* Button to add a new service item *@
        <div class="mt-3">
            <a asp-area="Admin" asp-controller="Service" asp-action="AddService" class="btn btn-success btn-sm"> Add Service</a>
        </div>

    </div>
</div>