@model AboutUpdateVM

<div class="col-md-3">
    <div class="form-floating">
        <input asp-for="SocialMedia.Facebook" type="url" class="form-control" placeholder="Facebook">
        <span asp-validation-for="SocialMedia.Facebook" class="text-danger"></span>
        <label asp-for="SocialMedia.Facebook">Facebook (URL(Optional))</label>

    </div>
</div>
<div class="col-md-3">
    <div class="form-floating">
        <input asp-for="SocialMedia.Instagram" type="url" class="form-control" placeholder="Instagram">
        <span asp-validation-for="SocialMedia.Instagram" class="text-danger"></span>
        <label asp-for="SocialMedia.Instagram">Instagram (URL(Optional))</label>
    </div>
</div>
<div class="col-md-3">
    <div class="form-floating">
        <input asp-for="SocialMedia.Twitter" type="url" class="form-control" placeholder="Twitter">
        <span asp-validation-for="SocialMedia.Twitter" class="text-danger"></span>
        <label asp-for="SocialMedia.Twitter">Twitter (URL(Optional))</label>
    </div>
</div>
<div class="col-md-3">
    <div class="form-floating">
        <input asp-for="SocialMedia.LinkedIn" type="url" class="form-control" placeholder="LinkedIn">
        <span asp-validation-for="SocialMedia.LinkedIn" class="text-danger"></span>
        <label asp-for="SocialMedia.LinkedIn">LinkedIn (URL(Optional))</label>
    </div>
</div>