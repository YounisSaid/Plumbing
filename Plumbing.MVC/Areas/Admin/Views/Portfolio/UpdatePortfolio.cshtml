@model PortfolioUpdateMV
@{
    ViewData["Title"] = "UpdatePortfolio";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}


<div>
    <h5 class="card-title">Update Portfolio Item</h5>

    <nav>
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
            <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Portfolio" asp-action="GetPortfolioList">Portfolio</a></li>
            <li class="breadcrumb-item active">Update</li>
        </ol>
    </nav>
</div>
<!-- Card with an image on top -->
<div class="card">
    <img src="~/images/@Model.FileName" class="card-img-top" alt="Plumbing Porftfolio">

</div><!-- End Card with an image on top -->
<div class="card">
    <div class="card-body pt-3">
        <form asp-area="Admin" asp-controller="Portfolio" asp-action="UpdatePortfolio" method="post" class="row g-3" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* Hidden fields for Id and RowVersion are essential for update operations *@
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="RowVersion" />

            @* Keep hidden fields for properties that must be submitted but aren't edited directly (like file metadata or CategoryId) *@
            
            <input type="hidden" asp-for="CategoryId" />


            <div class="col-md-12">
                <div class="form-floating">
                    <input asp-for="Title" type="text" class="form-control" placeholder="Header">
                    <label asp-for="Title">Title</label>
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
            </div>

            @* Note: The update view typically includes the option to upload a NEW file, replacing the old one. *@
            <div class="col-md-12">
                <div class="form-floating">
                    <input asp-for="Photo" accept="image/*" type="file" class="form-control" placeholder="Photo">
                    <label asp-for="Photo">Upload New Photo (Optional)</label>
                    <span asp-validation-for="Photo" class="text-danger"></span>
                </div>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary">Update</button>
                <button type="reset" class="btn btn-secondary">Reset</button>
            </div>
        </form>
    </div>
</div>