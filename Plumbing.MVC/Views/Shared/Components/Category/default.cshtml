@model List<CategoryListMVForUi>

<div class="row">
    <div class="col-lg-12 d-flex justify-content-center">
        <ul id="portfolio-flters">
            <li data-filter="*" class="filter-active">All</li>
            @foreach (var item in Model)
            {
                // Create a CSS-safe slug: lowercase and replace spaces/slashes with hyphens
                var filterSlug = item.Name.ToLower().Replace(" ", "-").Replace("/", "-");
                <li data-filter=".filter-@filterSlug">@item.Name</li>
            }
        </ul>
    </div>
</div>